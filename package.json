{
  "name": "rupeelens",
  "version": "0.1.0",
  "description": "UPI risk, security log, and Union Budget analysis in one TypeScript workspace.",
  "author": "Deepu",
  "license": "MIT",
  "repository": "github:Deepusleepy/RupeeLens",
  "homepage": "https://deepusleepy.github.io/RupeeLens/",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "build:pages": "npm run build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/labs.test.ts tests/workspaces.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "^8.1.5"
  },
  "overrides": {
    "postcss": "8.5.22"
  },
  "type": "module"
}
